{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle node HTTPS JSON job v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "execution", "challenge", "notBefore", "notAfter", "api"],
  "properties": {
    "version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$" },
    "execution": { "type": "integer", "minimum": 0 },
    "challenge": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "notBefore": { "type": "integer", "minimum": 0 },
    "notAfter": { "type": "integer", "minimum": 1 },
    "api": {
      "type": "object", "additionalProperties": false,
      "required": ["server", "path", "method", "extract"],
      "properties": {
        "server": { "type": "string", "maxLength": 253, "description": "Lowercase public DNS hostname. The running node additionally checks DNS public IP policy." },
        "path": { "type": "string", "maxLength": 1024, "description": "Exact origin-form request path/query; no URL fragment, credentials, control characters or backslashes." },
        "method": { "const": "GET" },
        "extract": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "pointer", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$" },
              "pointer": { "type": "string", "maxLength": 256, "description": "RFC 6901 JSON pointer into authenticated response body" },
              "type": { "enum": ["string", "number", "boolean", "decimal"] }
            }
          }
        }
      }
    }
  },
  "$comment": "Runtime enforces safe integers, unique extraction names, public DNS, strict path and a maximum 600000 ms execution window. JSON Schema alone is not the security validator."
}
