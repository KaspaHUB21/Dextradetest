[Unit]
Description=Oracle TLSNotary prototype
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=oracle-node
Group=oracle-node
WorkingDirectory=/opt/oracle-node
ExecStart=/usr/bin/node /opt/oracle-node/oracle-node.mjs start --data /var/lib/oracle-node
Environment=ORACLE_ENGINE_DIR=/opt/oracle-node/bin
Environment=PATH=/usr/bin:/bin
UMask=0077
StateDirectory=oracle-node
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oracle-node
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
CPUQuota=200%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
